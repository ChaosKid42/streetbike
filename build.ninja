# Ninja build for Streetbike.
#
#   ninja          assemble src/streetbike.asm -> build/streetbike.prg (acme),
#                  pack it into build/streetbike.d64 (c1541) and convert a
#                  cartridge build into build/streetbike.crt (cartconv)
#   ninja run      assemble, then start the game in VICE
#   ninja clean    remove the generated build artifacts
#
# Run from this directory: the paths below are relative to it.

ninja_required_version = 1.7

acme = acme
c1541 = c1541
cartconv = cartconv
vice = x64sc

# The source's `!to` directive selects the output file and the format.
# The PRG build uses the CBM (two-byte load address) format.
rule acme
  description = ACME $in
  command = $acme $in

build build/streetbike.prg: acme src/streetbike.asm

# The cart build defines CART, which switches the source to a cartridge
# layout: code at $8000 with a reset vector and the "CBM80" signature,
# sprite data in ROM copied to $2000 at boot, and the image padded to
# 8 KiB. ACME's plain format writes the raw binary.
rule acme_cart
  description = ACME (cart) $in
  command = $acme -DCART=1 $in

build build/streetbike.crt.bin: acme_cart src/streetbike.asm

# cartconv wraps the padded binary in a .crt container. `normal` is the
# generic 8 KiB cartridge type that maps to $8000-$9FFF.
rule crt
  description = CARTCONV $out
  command = $cartconv -t normal -i $in -o $out -n "streetbike"

build build/streetbike.crt: crt build/streetbike.crt.bin

# c1541 recreates the image from scratch on every run, so an existing
# streetbike.d64 is simply overwritten. CBM DOS limits the disk name to 16
# characters, the ID to two, and the file name to 16.
rule d64
  description = C1541 $out
  command = $c1541 -format "streetbike,sb" d64 $out -write $in streetbike

build build/streetbike.d64: d64 build/streetbike.prg

rule vice
  description = VICE $in
  command = $vice -autostart $in
  pool = console

build run: vice build/streetbike.prg

rule clean
  description = CLEAN build artifacts
  command = ninja -t clean

# `clean` is never created, so ninja always considers this target dirty.
build clean: clean

default build/streetbike.prg build/streetbike.d64 build/streetbike.crt
